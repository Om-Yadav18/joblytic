PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/joblytic
# Local: mongodb://127.0.0.1:27017/joblytic
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/joblytic?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d

RAPIDAPI_KEY=your_rapidapi_key_for_jsearch
GEMINI_API_KEY=your_google_gemini_api_key
